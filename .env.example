# Server-only PostgreSQL connection. Use the Supabase session pooler in production.
DATABASE_URL="postgresql://user:password@host:5432/database?sslmode=require"

# Better Auth must be a random 32+ character secret. Keep it in secret management.
BETTER_AUTH_SECRET="replace-with-a-random-32-character-secret"
BETTER_AUTH_URL="http://localhost:40000"
BETTER_AUTH_TRUSTED_ORIGINS="http://localhost:40000"

GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
RESEND_API_KEY=""
RESEND_FROM_EMAIL="Reports <reports@example.com>"
INVITATION_EXPIRES_HOURS="72"

# Controlled one-time setup. No password is accepted or generated here.
BOOTSTRAP_ADMIN_EMAIL="pongsakorn.wera@gmail.com"
BOOTSTRAP_ADMIN_NAME="Pongsakorn Wera"

# Safe for browser code; do not put secrets in NEXT_PUBLIC_* variables.
NEXT_PUBLIC_APP_URL="http://localhost:40000"
